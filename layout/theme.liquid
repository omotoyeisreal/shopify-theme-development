<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-currency="{{ shop.currency }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.brand_primary }}">
  {% if settings.favicon %}<link rel="icon" href="{{ settings.favicon | image_url: width: 64 }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {% if page_image %}<meta property="og:image" content="{{ page_image | image_url: width: 1200 }}">{% elsif settings.social_share_image %}<meta property="og:image" content="{{ settings.social_share_image | image_url: width: 1200 }}">{% endif %}
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | escape }}">
  {% if page_description %}<meta name="twitter:description" content="{{ page_description | escape }}">{% endif %}
  {% if page_image %}<meta name="twitter:image" content="{{ page_image | image_url: width: 1200 }}">{% elsif settings.social_share_image %}<meta name="twitter:image" content="{{ settings.social_share_image | image_url: width: 1200 }}">{% endif %}
  {% if template.name == 'product' %}{% render 'product-schema', product: product %}{% endif %}
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
</head>
<body class="template-{{ template.name | handle }}" style="--text: {{ settings.text | default: '#171717' }}; --muted: {{ settings.muted | default: '#666666' }}; --surface: {{ settings.surface | default: '#f7f7f5' }}; --surface-text: {{ settings.surface_foreground | default: '#171717' }}; --brand: {{ settings.brand_primary | default: '#171717' }}; --brand-foreground: {{ settings.brand_primary_foreground | default: '#ffffff' }};">
  <a class="skip-link" href="#MainContent">Skip to content</a>
  {% sections 'header-group' %}
  <main id="MainContent" role="main">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
</body>
</html>