<section class="section product" data-product-root>
  <div class="container product__layout">
    <div class="product__media">
      <div class="product-gallery">
        {% for media in product.media %}
          <div class="product-gallery__item" data-media-id="{{ media.id }}">
            {% case media.media_type %}
              {% when 'image' %}
                {{ media | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 800, 1000, 1200', sizes: '(min-width: 901px) 55vw, 100vw', alt: media.alt | default: product.title | escape }}
              {% else %}
                {{ media | media_tag: image_size: '1200x', controls: true }}
            {% endcase %}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="product__info">
      {% form 'product', product, class: 'product-form', data-product-form: '' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'vendor' %}
            {% if product.vendor != blank %}<p class="product__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>{% endif %}
          {% when 'title' %}
            <h1 {{ block.shopify_attributes }}>{{ product.title }}</h1>
          {% when 'price' %}
            {% assign current_variant = product.selected_or_first_available_variant %}
            <div class="product__price" data-product-price {{ block.shopify_attributes }}>{{ current_variant.price | money }}</div>
            <div class="product__compare-price" data-product-compare-price>{% if current_variant.compare_at_price > current_variant.price %}<s>{{ current_variant.compare_at_price | money }}</s>{% endif %}</div>
            <div class="product__unit-price" data-product-unit-price>{% if current_variant.unit_price_measurement %}{{ current_variant.unit_price | money }} / {% if current_variant.unit_price_measurement.reference_value != 1 %}{{ current_variant.unit_price_measurement.reference_value }}{% endif %}{{ current_variant.unit_price_measurement.reference_unit }}{% endif %}</div>
            {% if cart.taxes_included %}<p class="product__tax-note">Tax included in price.</p>{% endif %}
          {% when 'description' %}
            {% if product.description != blank %}<div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>{% endif %}
          {% when 'options' %}
            {% unless product.has_only_default_variant %}
              <div class="product-form__options" {{ block.shopify_attributes }}>
                {% for option in product.options_with_values %}
                  <label for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label>
                  <select id="Option-{{ section.id }}-{{ forloop.index0 }}" name="options[{{ option.name | escape }}]" data-option-index="{{ forloop.index0 }}">
                    {% for value in option.values %}
                      <option value="{{ value | escape }}" {% if value == product.selected_or_first_available_variant.options[forloop.index0] %}selected{% endif %}>{{ value }}</option>
                    {% endfor %}
                  </select>
                  <div class="product-option-swatches" aria-label="{{ option.name }} swatches">
                    {% for value in option.values %}
                      {% if value.swatch %}
                        <button type="button" class="product-swatch" data-swatch-option="{{ option.name | escape }}" data-swatch-value="{{ value | escape }}" aria-pressed="{% if value == product.selected_or_first_available_variant.options[forloop.parentloop.index0] %}true{% else %}false{% endif %}" aria-label="{{ value | escape }}" title="{{ value | escape }}">
                          {% if value.swatch.image %}
                            {{ value.swatch.image | image_url: width: 80 | image_tag: loading: 'lazy', width: 40, height: 40, alt: value | escape }}
                          {% elsif value.swatch.color %}
                            <span class="product-swatch__color" style="background: {{ value.swatch.color }};"></span>
                          {% endif %}
                        </button>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endfor %}
              </div>
            {% endunless %}
          {% when 'quantity' %}
            <label for="Quantity-{{ section.id }}" {{ block.shopify_attributes }}>Quantity</label>
            <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" {{ block.shopify_attributes }}>
          {% when 'selling_plans' %}
            {% if product.selling_plan_groups.size > 0 %}
              <fieldset class="product-form__selling-plans" {{ block.shopify_attributes }}>
                <legend>Purchase options</legend>
                {% unless product.requires_selling_plan %}<label><input type="radio" name="selling_plan" value="" checked> One-time purchase</label>{% endunless %}
                {% for group in product.selling_plan_groups %}
                  <p>{{ group.name }}</p>
                  {% for plan in group.selling_plans %}
                    <label><input type="radio" name="selling_plan" value="{{ plan.id }}" {% if product.requires_selling_plan and forloop.first and forloop.parentloop.first %}checked{% endif %}> {{ plan.name }}</label>
                  {% endfor %}
                {% endfor %}
              </fieldset>
            {% endif %}
          {% when 'gift_card_recipient' %}
            {% if product.gift_card? %}
              <fieldset class="gift-card-recipient" {{ block.shopify_attributes }}>
                <legend>Gift card recipient</legend>
                <label for="RecipientEmail-{{ section.id }}">Recipient email</label>
                <input id="RecipientEmail-{{ section.id }}" type="email" name="properties[Recipient email]" value="{{ form.email }}" required>
                <label for="RecipientName-{{ section.id }}">Recipient name</label>
                <input id="RecipientName-{{ section.id }}" type="text" name="properties[Recipient name]" value="{{ form.name }}" maxlength="255">
                <label for="RecipientMessage-{{ section.id }}">Message</label>
                <textarea id="RecipientMessage-{{ section.id }}" name="properties[Message]" maxlength="200" rows="4">{{ form.message }}</textarea>
                <label for="RecipientSendOn-{{ section.id }}">Send on</label>
                <input id="RecipientSendOn-{{ section.id }}" type="date" name="properties[Send on]" value="{{ gift_card.send_on | date: '%Y-%m-%d' }}" min="{{ 'now' | date: '%Y-%m-%d' }}">
                <input type="hidden" name="properties[__shopify_send_gift_card_to_recipient]" value="true">
                <input type="hidden" name="properties[__shopify_offset]" value="0">
              </fieldset>
            {% endif %}
          {% when 'buy_buttons' %}
            <div {{ block.shopify_attributes }}>
              <button class="button product-form__submit" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %} data-add-to-cart>
                {% if product.selected_or_first_available_variant.available %}Add to cart{% else %}Sold out{% endif %}
              </button>
              {% if block.settings.show_dynamic_checkout %}{% unless product.gift_card? %}{{ form | payment_button }}{% endunless %}{% endif %}
              {{ form | payment_terms }}
            </div>
          {% when 'trust' %}
            <div class="product__trust" {{ block.shopify_attributes }}><span>✓ Secure checkout</span><span>✓ Clear product information</span><span>✓ Responsive shopping</span></div>
          {% when 'custom_liquid' %}
            <div {{ block.shopify_attributes }}>{{ block.settings.liquid }}</div>
          {% when '@app' %}
            {% render block %}
        {% endcase %}
      {% endfor %}
      {% endform %}

      <div class="product-pickup-container" data-store-availability-container data-product-title="{{ product.title | escape }}" data-base-url="{{ shop.url }}{{ routes.root_url }}"></div>
      <section class="product-recommendations" data-product-recommendations
        data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent=related">
        <div data-recommendations-content>
          {% if recommendations.performed? and recommendations.products_count > 0 %}
            <h2>You may also like</h2>
            <div class="product-grid">{% for related in recommendations.products %}{% render 'product-card', product: related %}{% endfor %}</div>
          {% endif %}
        </div>
      </section>
    </div>
  </div>
</section>

<script type="application/json" data-product-variants>{{ product.variants | json }}</script>

{% schema %}
{
  "name": "Main product",
  "settings": [],
  "blocks": [
    {"type":"vendor","name":"Vendor","limit":1},
    {"type":"title","name":"Title","limit":1},
    {"type":"price","name":"Price","limit":1},
    {"type":"description","name":"Description","limit":1},
    {"type":"options","name":"Variant picker","limit":1},
    {"type":"quantity","name":"Quantity","limit":1},
    {"type":"selling_plans","name":"Selling plans","limit":1},
    {"type":"gift_card_recipient","name":"Gift card recipient","limit":1},
    {"type":"buy_buttons","name":"Buy buttons","limit":1,"settings":[{"type":"checkbox","id":"show_dynamic_checkout","label":"Show accelerated checkout buttons","default":true}]},
    {"type":"trust","name":"Trust message","limit":1},
    {"type":"custom_liquid","name":"Custom Liquid","settings":[{"type":"liquid","id":"liquid","label":"Liquid code"}]},
    {"type":"@app"}
  ],
  "presets":[{"name":"Main product","blocks":[{"type":"vendor"},{"type":"title"},{"type":"price"},{"type":"options"},{"type":"quantity"},{"type":"selling_plans"},{"type":"gift_card_recipient"},{"type":"buy_buttons"},{"type":"description"},{"type":"trust"}]}]
}
{% endschema %}
