<section class="hero">
  <div class="container hero__content">
    {% if section.settings.eyebrow != blank %}
      <p>{{ section.settings.eyebrow }}</p>
    {% endif %}

    <h1>{{ section.settings.heading }}</h1>

    {% if section.settings.text != blank %}
      <p>{{ section.settings.text }}</p>
    {% endif %}

    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <a class="button" href="{{ section.settings.button_link }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Designed for modern ecommerce"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A storefront built around your customer."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "A responsive Shopify theme foundation focused on clarity, product discovery, and conversion opportunities."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
