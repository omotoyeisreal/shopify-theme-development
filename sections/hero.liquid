{% assign hero_image = section.settings.image %}
<section class="hero hero--{{ section.settings.height }} hero--{{ section.settings.content_position }}" data-hero>
  <div class="hero__media" aria-hidden="true">
    {% if section.settings.video != blank %}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, loading: 'eager', class: 'hero__video' }}
    {% elsif hero_image != blank %}
      {{ hero_image | image_url: width: 2400 | image_tag: widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'hero__image', alt: '' }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__placeholder' }}
    {% endif %}
  </div>
  <div class="hero__overlay" style="--hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  <div class="container hero__inner">
    <div class="hero__content hero__content--{{ section.settings.text_alignment }}" style="--hero-content-width: {{ section.settings.content_width }}%;">
      {% if section.settings.eyebrow != blank %}<p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h1>{{ section.settings.heading }}</h1>
      {% if section.settings.text != blank %}<div class="hero__text rte">{{ section.settings.text }}</div>{% endif %}
      <div class="hero__actions">
        {% if section.settings.button_label != blank and section.settings.button_link != blank %}<a class="button button--large" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}
        {% if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank %}<a class="button button--ghost" href="{{ section.settings.secondary_button_link }}">{{ section.settings.secondary_button_label }}</a>{% endif %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Hero",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Designed for modern commerce"},
    {"type":"text","id":"heading","label":"Heading","default":"A storefront built around your customer."},
    {"type":"richtext","id":"text","label":"Body text","default":"<p>Create a memorable shopping journey with flexible storytelling, product discovery, and conversion-focused layouts.</p>"},
    {"type":"image_picker","id":"image","label":"Hero image"},
    {"type":"video","id":"video","label":"Hero video"},
    {"type":"range","id":"overlay_opacity","label":"Image overlay","min":0,"max":80,"step":5,"unit":"%","default":15},
    {"type":"select","id":"height","label":"Section height","options":[{"value":"medium","label":"Medium"},{"value":"large","label":"Large"},{"value":"full","label":"Full screen"}],"default":"large"},
    {"type":"select","id":"content_position","label":"Content position","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"left"},
    {"type":"select","id":"text_alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"left"},
    {"type":"range","id":"content_width","label":"Content width","min":40,"max":90,"step":5,"unit":"%","default":65},
    {"type":"text","id":"button_label","label":"Primary button label","default":"Shop collection"},
    {"type":"url","id":"button_link","label":"Primary button link","default":"/collections/all"},
    {"type":"text","id":"secondary_button_label","label":"Secondary button label","default":"Explore products"},
    {"type":"url","id":"secondary_button_link","label":"Secondary button link","default":"/collections/all"}
  ],
  "presets":[{"name":"Hero"}]
}
{% endschema %}