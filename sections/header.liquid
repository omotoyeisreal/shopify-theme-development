<header class="header">
  <div class="container header__inner">
    <a class="header__logo" href="{{ routes.root_url }}">{{ shop.name }}</a>
    <nav class="header__nav" aria-label="Main navigation">
      {% for link in section.settings.menu.links %}
        <div class="header__nav-item">
          <a href="{{ link.url }}"{% if link.links.size > 0 %} aria-describedby="DesktopSubmenuToggle-{{ section.id }}-{{ forloop.index }}"{% endif %}>{{ link.title }}</a>
          {% if link.links.size > 0 %}
            <button class="header__submenu-toggle" type="button" aria-expanded="false" aria-controls="DesktopSubmenu-{{ section.id }}-{{ forloop.index }}">
              <span class="visually-hidden">Toggle {{ link.title }} navigation</span>
            </button>
            <div id="DesktopSubmenu-{{ section.id }}-{{ forloop.index }}" class="header__submenu" hidden>
              {% for child_link in link.links %}
                <div class="header__submenu-item">
                  <a href="{{ child_link.url }}"{% if child_link.links.size > 0 %} aria-describedby="DesktopNestedToggle-{{ section.id }}-{{ forloop.index }}-{{ forloop.parentloop.index }}"{% endif %}>{{ child_link.title }}</a>
                  {% if child_link.links.size > 0 %}
                    <button class="header__nested-toggle" type="button" aria-expanded="false" aria-controls="DesktopNested-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}">
                      <span class="visually-hidden">Toggle {{ child_link.title }} navigation</span>
                    </button>
                    <div id="DesktopNested-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}" class="header__submenu-nested" hidden>
                      {% for grandchild_link in child_link.links %}<a href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a>{% endfor %}
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </nav>
    <div class="header__actions">
      {% if shop.customer_accounts_enabled %}<shopify-account menu="{{ section.settings.customer_account_menu }}"></shopify-account>{% endif %}
      <form class="header__search" action="{{ routes.search_url }}" method="get" role="search">
        <label class="visually-hidden" for="HeaderSearch-{{ section.id }}">Search</label>
        <input id="HeaderSearch-{{ section.id }}" type="search" name="q" placeholder="Search" autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false" data-predictive-search aria-controls="PredictiveSearch-{{ section.id }}" aria-expanded="false" aria-haspopup="listbox" aria-autocomplete="list">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit">Search</button>
      </form>
      <a class="header__cart" href="{{ routes.cart_url }}">Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="MobileMenu-{{ section.id }}" data-menu-toggle><span class="visually-hidden">Toggle navigation</span>Menu</button>
    </div>
  </div>
  <nav id="MobileMenu-{{ section.id }}" class="mobile-menu" aria-label="Mobile navigation" data-mobile-menu>
    <div class="container">
      {% if shop.customer_accounts_enabled %}<div class="mobile-menu__account"><shopify-account menu="{{ section.settings.customer_account_menu }}"></shopify-account></div>{% endif %}
      {% for link in section.settings.menu.links %}
        <div class="mobile-menu__item">
          <a href="{{ link.url }}">{{ link.title }}</a>
          {% if link.links.size > 0 %}
            <div class="mobile-menu__submenu">
              {% for child_link in link.links %}
                <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                {% if child_link.links.size > 0 %}<div class="mobile-menu__submenu-nested">{% for grandchild_link in child_link.links %}<a href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a>{% endfor %}</div>{% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </nav>
  <script>
    (() => {
      const closeAll = (except) => {
        document.querySelectorAll('.header__submenu-toggle[aria-expanded="true"]').forEach((button) => {
          if (button === except) return;
          button.setAttribute('aria-expanded', 'false');
          const menu = document.getElementById(button.getAttribute('aria-controls'));
          if (menu) menu.hidden = true;
        });
        document.querySelectorAll('.header__nested-toggle[aria-expanded="true"]').forEach((button) => {
          button.setAttribute('aria-expanded', 'false');
          const menu = document.getElementById(button.getAttribute('aria-controls'));
          if (menu) menu.hidden = true;
        });
      };

      document.querySelectorAll('.header__submenu-toggle').forEach((button) => {
        button.addEventListener('click', () => {
          const expanded = button.getAttribute('aria-expanded') === 'true';
          closeAll(expanded ? null : button);
          button.setAttribute('aria-expanded', String(!expanded));
          const menu = document.getElementById(button.getAttribute('aria-controls'));
          if (menu) menu.hidden = expanded;
        });

        button.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            button.setAttribute('aria-expanded', 'false');
            const menu = document.getElementById(button.getAttribute('aria-controls'));
            if (menu) menu.hidden = true;
            button.focus();
          }
        });
      });

      document.querySelectorAll('.header__nested-toggle').forEach((button) => {
        button.addEventListener('click', () => {
          const expanded = button.getAttribute('aria-expanded') === 'true';
          button.setAttribute('aria-expanded', String(!expanded));
          const menu = document.getElementById(button.getAttribute('aria-controls'));
          if (menu) menu.hidden = expanded;
        });

        button.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            button.setAttribute('aria-expanded', 'false');
            const menu = document.getElementById(button.getAttribute('aria-controls'));
            if (menu) menu.hidden = true;
            button.focus();
          }
        });
      });
    })();
  </script>
</header>
{% schema %}
{"name":"Header","settings":[{"type":"link_list","id":"menu","label":"Navigation menu","default":"main-menu"},{"type":"link_list","id":"customer_account_menu","label":"Customer account menu","default":"customer-account-main-menu"}]}
{% endschema %}