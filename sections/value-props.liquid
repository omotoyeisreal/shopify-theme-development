<section class="section">
  <div class="container">
    <div class="value-props">
      {% for block in section.blocks %}
        <div class="value-prop" {{ block.shopify_attributes }}>
          <strong>{{ block.settings.heading }}</strong>
          <span>{{ block.settings.text }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Value propositions",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "prop",
      "name": "Value proposition",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Fast shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Reliable delivery"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value propositions",
      "blocks": [
        { "type": "prop" },
        { "type": "prop" },
        { "type": "prop" }
      ]
    }
  ]
}
{% endschema %}
