<footer class="footer">
  <div class="container footer__inner">
    <div>
      <span>{{ shop.name }}</span>
      <span>{{ section.settings.text }}</span>
    </div>

    {% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
      <div class="footer__localization">
        {% form 'localization', class: 'localization-form' %}
          {% if localization.available_countries.size > 1 %}
            <label for="FooterCountry-{{ section.id }}">Country</label>
            <select id="FooterCountry-{{ section.id }}" name="country_code" onchange="this.form.submit()">
              {% for country in localization.available_countries %}
                <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }})</option>
              {% endfor %}
            </select>
          {% endif %}
          {% if localization.available_languages.size > 1 %}
            <label for="FooterLanguage-{{ section.id }}">Language</label>
            <select id="FooterLanguage-{{ section.id }}" name="language_code" onchange="this.form.submit()">
              {% for language in localization.available_languages %}
                <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
              {% endfor %}
            </select>
          {% endif %}
          <noscript><button class="button" type="submit">Apply preferences</button></noscript>
        {% endform %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="footer__social" aria-label="Social media">
        {% for block in section.blocks %}
          {% if block.settings.url != blank %}
            <a href="{{ block.settings.url }}" aria-label="{{ block.settings.platform }}" {{ block.shopify_attributes }}>
              {% case block.settings.platform %}
                {% when 'Facebook' %}f
                {% when 'Instagram' %}◎
                {% when 'X' %}𝕏
                {% when 'YouTube' %}▶
                {% when 'TikTok' %}♪
                {% when 'Pinterest' %}P
              {% endcase %}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="footer__shop-follow">
      {{ shop | login_button: action: 'follow' }}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Footer text",
      "default": "Built with Shopify Online Store 2.0"
    }
  ],
  "blocks": [
    {
      "type": "social",
      "name": "Social link",
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Social media icon",
          "options": [
            {"value":"Facebook","label":"Facebook"},
            {"value":"Instagram","label":"Instagram"},
            {"value":"X","label":"X"},
            {"value":"YouTube","label":"YouTube"},
            {"value":"TikTok","label":"TikTok"},
            {"value":"Pinterest","label":"Pinterest"}
          ],
          "default": "Instagram"
        },
        {"type":"url","id":"url","label":"Social media link"}
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {"type":"social","settings":{"platform":"Instagram"}},
        {"type":"social","settings":{"platform":"Facebook"}},
        {"type":"social","settings":{"platform":"YouTube"}}
      ]
    }
  ]
}
{% endschema %}
