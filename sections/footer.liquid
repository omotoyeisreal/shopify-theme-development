<footer class="footer" style="--footer-bg: {{ section.settings.background }}; --footer-text: {{ section.settings.text_color }};">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="{{ routes.root_url }}" class="footer__logo" aria-label="{{ shop.name }}">
          {% if section.settings.logo %}{{ section.settings.logo | image_url: width: 500 | image_tag: widths: '160, 260, 400, 500', sizes: '180px', loading: 'lazy', alt: shop.name }}{% else %}<span>{{ shop.name }}</span>{% endif %}
        </a>
        {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
      </div>
      {% for block in section.blocks %}
        {% if block.type == 'menu' %}
          <div class="footer__column" {{ block.shopify_attributes }}>
            <h2>{{ block.settings.heading }}</h2>
            {% if block.settings.menu != blank %}
              <ul class="footer__links" role="list">{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul>
            {% endif %}
          </div>
        {% elsif block.type == 'social' %}
          <div class="footer__column" {{ block.shopify_attributes }}>
            <h2>{{ block.settings.heading }}</h2>
            <div class="footer__social" aria-label="Social media">
              {% if block.settings.instagram != blank %}<a href="{{ block.settings.instagram }}" aria-label="Instagram">Instagram</a>{% endif %}
              {% if block.settings.facebook != blank %}<a href="{{ block.settings.facebook }}" aria-label="Facebook">Facebook</a>{% endif %}
              {% if block.settings.youtube != blank %}<a href="{{ block.settings.youtube }}" aria-label="YouTube">YouTube</a>{% endif %}
              {% if block.settings.tiktok != blank %}<a href="{{ block.settings.tiktok }}" aria-label="TikTok">TikTok</a>{% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="footer__bottom">
      <span>{{ section.settings.copyright_text }}</span>
      {% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
        {% form 'localization', class: 'localization-form' %}
          {% if localization.available_countries.size > 1 %}<label for="FooterCountry-{{ section.id }}">Country<select id="FooterCountry-{{ section.id }}" name="country_code" onchange="this.form.submit()">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }})</option>{% endfor %}</select></label>{% endif %}
          {% if localization.available_languages.size > 1 %}<label for="FooterLanguage-{{ section.id }}">Language<select id="FooterLanguage-{{ section.id }}" name="language_code" onchange="this.form.submit()">{% for language in localization.available_languages %}<option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>{{ language.endonym_name | capitalize }}</option>{% endfor %}</select></label>{% endif %}
          <noscript><button class="button" type="submit">Apply preferences</button></noscript>
        {% endform %}
      {% endif %}
    </div>
    <div class="footer__shop-follow">{{ shop | login_button: action: 'follow' }}</div>
  </div>
</footer>

{% schema %}
{
  "name":"Footer",
  "settings":[
    {"type":"image_picker","id":"logo","label":"Logo"},
    {"type":"textarea","id":"text","label":"Brand text","default":"A flexible storefront system built for thoughtful product discovery and a smoother customer journey."},
    {"type":"text","id":"copyright_text","label":"Copyright text","default":"© 2026 Flow Commerce"},
    {"type":"color","id":"background","label":"Background color","default":"#171717"},
    {"type":"color","id":"text_color","label":"Text color","default":"#ffffff"}
  ],
  "blocks":[
    {"type":"menu","name":"Footer menu","settings":[{"type":"text","id":"heading","label":"Heading","default":"Explore"},{"type":"link_list","id":"menu","label":"Footer menu","default":"footer"}]},
    {"type":"social","name":"Social media","settings":[{"type":"text","id":"heading","label":"Heading","default":"Follow along"},{"type":"url","id":"instagram","label":"Instagram link"},{"type":"url","id":"facebook","label":"Facebook link"},{"type":"url","id":"youtube","label":"YouTube link"},{"type":"url","id":"tiktok","label":"TikTok link"}]}
  ],
  "max_blocks":4,
  "presets":[{"name":"Footer","blocks":[{"type":"menu"},{"type":"menu"},{"type":"social"}]}]
}
{% endschema %}