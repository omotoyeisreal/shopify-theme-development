<section class="section">
  <div class="container">
    <div class="section__header">
      <p>{{ collection.products_count }} products</p>
      <h1>{{ collection.title }}</h1>
      {% if collection.featured_image %}{{ collection.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '700, 1000, 1400', sizes: '100vw', alt: collection.featured_image.alt | default: collection.title | escape }}{% endif %}
      {% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}
    </div>

    <form class="collection-filters" method="get">
      <label for="SortBy">Sort by</label>
      <select id="SortBy" name="sort_by" onchange="this.form.submit()">
        {% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}
      </select>
      {% if collection.filters.size > 0 %}
        {% for filter in collection.filters %}
          <fieldset>
            <legend>{{ filter.label }}</legend>
            {% case filter.type %}
              {% when 'list' %}
                {% for value in filter.values %}
                  {% assign value_id = 'CollectionFilter-' | append: section.id | append: '-' | append: forloop.parentloop.index | append: '-' | append: forloop.index %}
                  <input id="{{ value_id }}" type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} onchange="this.form.submit()">
                  <label for="{{ value_id }}">{% if value.label %}{{ value.label }}{% endif %} ({{ value.count }})</label>
                {% endfor %}
              {% when 'price_range' %}
                {% assign min_id = 'CollectionFilterMin-' | append: section.id | append: '-' | append: forloop.index %}
                {% assign max_id = 'CollectionFilterMax-' | append: section.id | append: '-' | append: forloop.index %}
                <label for="{{ min_id }}">{{ filter.min_value.label }}</label>
                <input id="{{ min_id }}" type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | default: 0 }}" min="0">
                <label for="{{ max_id }}">{{ filter.max_value.label }}</label>
                <input id="{{ max_id }}" type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | default: filter.range_max }}" min="0">
            {% endcase %}
          </fieldset>
        {% endfor %}
      {% endif %}
    </form>

    {% paginate collection.products by 12 %}
      <div class="product-grid">
        {% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>No products found in this collection.</p>{% endfor %}
      </div>
      {% if paginate.pages > 1 %}<nav class="pagination" aria-label="Pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">Previous</a>{% endif %}<span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">Next</a>{% endif %}</nav>{% endif %}
    {% endpaginate %}
  </div>
</section>
{% schema %}
{"name":"Main collection","settings":[]}
{% endschema %}
