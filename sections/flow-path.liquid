<section class="section flow-path">
  <div class="container">
    <div class="flow-path__intro"><p class="section__eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2>{% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}</div>
    <div class="flow-path__grid">
      {% for block in section.blocks %}
        <article class="flow-path__item" {{ block.shopify_attributes }}>
          <span class="flow-path__number">{{ forloop.index | prepend: '0' }}</span>
          <h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p>
          {% if block.settings.link_label != blank and block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.link_label }} <span aria-hidden="true">↗</span></a>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Conversion path",
  "max_blocks":3,
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"The Flow"},
    {"type":"text","id":"heading","label":"Heading","default":"A shopping journey designed to move naturally."},
    {"type":"textarea","id":"text","label":"Description","default":"A distinctive section for guiding customers from discovery to confidence to action."}
  ],
  "blocks":[{"type":"step","name":"Flow step","settings":[{"type":"text","id":"heading","label":"Heading","default":"Discover"},{"type":"textarea","id":"text","label":"Body text","default":"Introduce collections, stories, and products with clear visual hierarchy."},{"type":"text","id":"link_label","label":"Link label","default":"Explore"},{"type":"url","id":"link","label":"Link","default":"/collections/all"}]}],
  "presets":[{"name":"Conversion path","blocks":[{"type":"step","settings":{"heading":"Discover","text":"Introduce collections, stories, and products with clear visual hierarchy.","link_label":"Explore","link":"/collections/all"}},{"type":"step","settings":{"heading":"Consider","text":"Give shoppers the details, proof, and context they need to choose confidently.","link_label":"Learn more","link":"/collections/all"}},{"type":"step","settings":{"heading":"Convert","text":"Keep the path to cart and checkout simple, focused, and friction-aware.","link_label":"Shop now","link":"/collections/all"}}]}]
}
{% endschema %}