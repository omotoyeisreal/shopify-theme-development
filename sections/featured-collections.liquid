<section class="section section--collections">
  <div class="container">
    <div class="section__header section__header--split">
      <div><p class="section__eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    </div>
    <div class="collection-grid collection-grid--{{ section.blocks.size }}">
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}
        <article class="collection-card" {{ block.shopify_attributes }}>
          {% if collection != blank %}
            <a class="collection-card__media" href="{{ collection.url }}" aria-label="Shop {{ collection.title }}">
              {% if collection.featured_image %}{{ collection.featured_image | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 901px) 33vw, 100vw', loading: 'lazy', alt: collection.featured_image.alt | default: collection.title | escape }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}{% endif %}
              <span class="collection-card__arrow" aria-hidden="true">↗</span>
            </a>
            <div class="collection-card__content"><h3><a href="{{ collection.url }}">{{ collection.title }}</a></h3>{% if section.settings.show_count %}<p>{{ collection.products_count }} products</p>{% endif %}</div>
          {% else %}
            <div class="collection-card__media collection-card__media--empty">{{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}</div>
            <div class="collection-card__content"><h3>{{ block.settings.heading }}</h3><p>Select a collection in the theme editor.</p></div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Featured collections",
  "max_blocks":4,
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Shop by category"},
    {"type":"text","id":"heading","label":"Heading","default":"Find your next favorite."},
    {"type":"textarea","id":"text","label":"Description","default":"Guide customers into the right collection with visual, editorial-first discovery."},
    {"type":"checkbox","id":"show_count","label":"Show product count","default":true}
  ],
  "blocks":[{"type":"collection","name":"Collection","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"heading","label":"Fallback heading","default":"Featured collection"}]}],
  "presets":[{"name":"Featured collections","blocks":[{"type":"collection"},{"type":"collection"},{"type":"collection"}]}]
}
{% endschema %}